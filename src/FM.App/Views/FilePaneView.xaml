<UserControl x:Class="FM.App.Views.FilePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:FM.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:FilePaneViewModel}"
             d:DesignHeight="500" d:DesignWidth="600"
             Focusable="True"
             PreviewMouseDown="OnPanePreviewMouseDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Outer border displaying active pane accent border for Windows 11 visual feedback -->
    <Border x:Name="PaneBorder"
            Background="#FFFFFF"
            BorderThickness="2"
            CornerRadius="4"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#E5E7EB" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="#0078D4" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Navigation and Address Bar -->
                <RowDefinition Height="Auto" /> <!-- Loading bar -->
                <RowDefinition Height="Auto" /> <!-- Inline Error Banner -->
                <RowDefinition Height="*" />    <!-- File List (Virtualized) -->
                <RowDefinition Height="Auto" /> <!-- Status Footer -->
            </Grid.RowDefinitions>

            <!-- Navigation Toolbar & Address Bar -->
            <Grid Grid.Row="0" Margin="4,4,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Back -->
                    <ColumnDefinition Width="Auto" /> <!-- Forward -->
                    <ColumnDefinition Width="Auto" /> <!-- Up -->
                    <ColumnDefinition Width="*" />    <!-- Editable Address Box -->
                    <ColumnDefinition Width="Auto" /> <!-- Go Button -->
                    <ColumnDefinition Width="Auto" /> <!-- Refresh Button -->
                    <ColumnDefinition Width="Auto" /> <!-- New Folder Button -->
                    <ColumnDefinition Width="Auto" /> <!-- Rename Button -->
                    <ColumnDefinition Width="Auto" /> <!-- Undo Button -->
                    <ColumnDefinition Width="Auto" /> <!-- Copy to Other Pane Button -->
                    <ColumnDefinition Width="Auto" /> <!-- Move to Other Pane Button -->
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding GoBackCommand}"
                        ToolTip="Back (Alt+Left)"
                        Width="28" Height="26" Margin="1"
                        Content="◄" FontSize="11" />

                <Button Grid.Column="1"
                        Command="{Binding GoForwardCommand}"
                        ToolTip="Forward (Alt+Right)"
                        Width="28" Height="26" Margin="1"
                        Content="►" FontSize="11" />

                <Button Grid.Column="2"
                        Command="{Binding GoUpCommand}"
                        ToolTip="Up to Parent (Backspace)"
                        Width="28" Height="26" Margin="1"
                        Content="▲" FontSize="11" />

                <!-- Address Bar (Press Enter to Navigate) -->
                <TextBox x:Name="AddressTextBox"
                         Grid.Column="3"
                         Margin="3,1"
                         Height="26"
                         VerticalContentAlignment="Center"
                         Padding="4,0"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnAddressTextBoxKeyDown" />

                <Button Grid.Column="4"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Binding AddressText}"
                        ToolTip="Go"
                        Width="28" Height="26" Margin="1"
                        Content="➔" FontSize="12" />

                <Button Grid.Column="5"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Refresh (F5)"
                        Width="28" Height="26" Margin="1"
                        Content="↻" FontSize="13" />

                <Button Grid.Column="6"
                        Command="{Binding NewFolderCommand}"
                        ToolTip="New Folder (Ctrl+Shift+N)"
                        Width="28" Height="26" Margin="1"
                        Content="📁+" FontSize="10" />

                <Button Grid.Column="7"
                        Command="{Binding RenameCommand}"
                        ToolTip="Rename (F2)"
                        Width="28" Height="26" Margin="1"
                        Content="✎" FontSize="11" />

                <Button Grid.Column="8"
                        Command="{Binding UndoCommand}"
                        ToolTip="Undo (Ctrl+Z)"
                        Width="28" Height="26" Margin="1"
                        Content="↶" FontSize="12" />

                <Button Grid.Column="9"
                        Command="{Binding DataContext.CopyToOtherPaneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Copy to other pane (Ctrl+Shift+C)"
                        Width="32" Height="26" Margin="1"
                        Content="📋➔" FontSize="10" />

                <Button Grid.Column="10"
                        Command="{Binding DataContext.MoveToOtherPaneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Move to other pane (Ctrl+Shift+M)"
                        Width="32" Height="26" Margin="1"
                        Content="✂➔" FontSize="10" />
            </Grid>

            <!-- Progress Indicator -->
            <ProgressBar Grid.Row="1"
                         Height="2"
                         BorderThickness="0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Foreground="#0078D4"
                         Background="Transparent" />

            <!-- Inline Error Banner -->
            <Border Grid.Row="2"
                    Margin="4,2"
                    Padding="8,4"
                    Background="#FEF2F2"
                    BorderBrush="#F87171"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorMessage}"
                               ToolTip="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Command="{Binding DismissErrorCommand}"
                            Content="✕"
                            Width="20" Height="20"
                            Margin="4,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B91C1C"
                            Cursor="Hand" />
                </Grid>
            </Border>

            <!-- File List: UI Virtualization Enabled. Do NOT wrap inside a ScrollViewer! -->
            <ListView x:Name="FileListView"
                      Grid.Row="3"
                      Margin="2"
                      ItemsSource="{Binding Items}"
                      SelectionMode="Extended"
                      AllowDrop="True"
                      SelectionChanged="OnFileListViewSelectionChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      GridViewColumnHeader.Click="OnGridViewColumnHeaderClicked"
                      PreviewMouseLeftButtonDown="OnFileListViewPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="OnFileListViewPreviewMouseLeftButtonUp"
                      MouseMove="OnFileListViewMouseMove"
                      DragEnter="OnFileListViewDragEnter"
                      DragOver="OnFileListViewDragOver"
                      DragLeave="OnFileListViewDragLeave"
                      Drop="OnFileListViewDrop"
                      MouseDoubleClick="OnFileListViewMouseDoubleClick"
                      KeyDown="OnFileListViewKeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Opacity" Value="{Binding Opacity}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <!-- Name Column with Icon -->
                        <GridViewColumn Width="260">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Name" Tag="Name" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="16" Height="16"
                                               Margin="0,0,6,0"
                                               Source="{Binding Icon}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Size Column -->
                        <GridViewColumn Width="90">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Size" Tag="Size" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedSize}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="#4B5563" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Modified Column -->
                        <GridViewColumn Width="140">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Modified" Tag="Modified" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedModified}"
                                               VerticalAlignment="Center"
                                               Foreground="#4B5563" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Type Column -->
                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Type" Tag="Type" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayType}"
                                               VerticalAlignment="Center"
                                               Foreground="#6B7280" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Status Footer -->
            <Border Grid.Row="4"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Padding="6,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectionStatusText}"
                               FontSize="11" Foreground="#6B7280" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SortStatusText}"
                               FontSize="11" Foreground="#9CA3AF" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
