<UserControl x:Class="FM.App.Views.FilePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FM.App.ViewModels"
             xmlns:conv="clr-namespace:FM.App.Converters"
             xmlns:models="clr-namespace:FM.App.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FilePaneViewModel}"
             d:DesignHeight="600" d:DesignWidth="700"
             Focusable="True"
             PreviewMouseDown="OnPanePreviewMouseDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

        <!-- Crumb button style -->
        <Style x:Key="CrumbButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crumb chevron dropdown button style -->
        <Style x:Key="CrumbChevronButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FCE7F3" />
                                <Setter Property="Foreground" Value="#D92662" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FBCFE8" />
                                <Setter Property="Foreground" Value="#BE185D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown ContextMenu for Chevron subfolders -->
        <Style x:Key="BreadcrumbSubfolderContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                MinWidth="180"
                                MaxWidth="320">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12" />
                            </Border.Effect>
                            <ScrollViewer MaxHeight="360"
                                          CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item in Chevron subfolders dropdown -->
        <Style x:Key="BreadcrumbSubfolderMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="IconText"
                                           Grid.Column="0"
                                           Text="📁"
                                           FontSize="12"
                                           Foreground="#D92662"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock x:Name="HeaderText"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Header}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#D92662" />
                                <Setter TargetName="HeaderText" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="IconText" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderText" Property="Foreground" Value="#9CA3AF" />
                                <Setter TargetName="IconText" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-click ContextMenu for Breadcrumb Segment -->
        <Style x:Key="BreadcrumbSegmentContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                MinWidth="160">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item in Breadcrumb Segment ContextMenu -->
        <Style x:Key="BreadcrumbSegmentMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                                <TextBlock x:Name="HeaderText"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Header}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6" />
                                <Setter TargetName="HeaderText" Property="Foreground" Value="#D92662" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridViewColumnHeader Clean Style -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#F3F4F6" />
        </Style>

        <!-- Modern Windows 11 Dark ContextMenu Style -->
        <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#383838" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.55" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Windows 11 Dark MenuItem Style -->
        <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,2,10,2" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  Margin="6,0,10,0" />

                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#383838" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Top Action Button Style (Cut, Copy, Rename, Delete) -->
        <Style x:Key="ModernTopActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#383838" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#484848" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Separator Style -->
        <Style x:Key="ModernMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#363636" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}"
                                Height="{TemplateBinding Height}"
                                Margin="{TemplateBinding Margin}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu for Selected Item (Matching Windows 11 Modern Context Menu) -->
        <ContextMenu x:Key="ModernFileItemContextMenu" Style="{StaticResource ModernContextMenuStyle}">
            <!-- Top Horizontal Action Bar (Cut, Copy, Rename, Delete) -->
            <Border Background="Transparent" Margin="2,2,2,4">
                <Grid Width="236">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding CutCommand}"
                            Click="OnTopActionButtonClick"
                            ToolTip="Cut (Ctrl+X)"
                            Style="{StaticResource ModernTopActionButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✂" FontSize="13" HorizontalAlignment="Center" Foreground="#F3F4F6" />
                            <TextBlock Text="Cut" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center" Foreground="#D1D5DB" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Command="{Binding CopyCommand}"
                            Click="OnTopActionButtonClick"
                            ToolTip="Copy (Ctrl+C)"
                            Style="{StaticResource ModernTopActionButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" Foreground="#F3F4F6" />
                            <TextBlock Text="Copy" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center" Foreground="#D1D5DB" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding RenameCommand}"
                            Click="OnTopActionButtonClick"
                            ToolTip="Rename (F2)"
                            Style="{StaticResource ModernTopActionButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📝" FontSize="13" HorizontalAlignment="Center" Foreground="#F3F4F6" />
                            <TextBlock Text="Rename" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center" Foreground="#D1D5DB" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Command="{Binding DeleteToRecycleBinCommand}"
                            Click="OnTopActionButtonClick"
                            ToolTip="Delete to Recycle Bin (Del)"
                            Style="{StaticResource ModernTopActionButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🗑" FontSize="13" HorizontalAlignment="Center" Foreground="#F87171" />
                            <TextBlock Text="Delete" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center" Foreground="#F87171" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Separator Style="{StaticResource ModernMenuSeparatorStyle}" />

            <!-- Open -->
            <MenuItem Header="Open"
                      InputGestureText="Enter"
                      Icon="📂"
                      Command="{Binding OpenItemCommand}"
                      CommandParameter="{Binding SelectedItem}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <!-- Open in new tab -->
            <MenuItem Header="Open in new tab"
                      Icon="🗗"
                      Command="{Binding OpenInNewTabCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <!-- Open in new window -->
            <MenuItem Header="Open in new window"
                      Icon="↗"
                      Command="{Binding OpenInNewWindowCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <!-- Pin to Quick access -->
            <MenuItem Header="Pin to Quick access"
                      Icon="📌"
                      Command="{Binding PinToQuickAccessCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <!-- Compress to ZIP -->
            <MenuItem Header="Compress to ZIP"
                      Icon="🗜"
                      Command="{Binding CompressToZipCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <!-- Copy as path -->
            <MenuItem Header="Copy as path"
                      InputGestureText="Ctrl+Shift+C"
                      Icon="📄"
                      Command="{Binding CopyPathCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <!-- Properties -->
            <MenuItem Header="Properties"
                      InputGestureText="Alt+Enter"
                      Icon="🔧"
                      Command="{Binding OpenPropertiesCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <Separator Style="{StaticResource ModernMenuSeparatorStyle}" />

            <!-- Open in Terminal -->
            <MenuItem Header="Open in Terminal"
                      Icon="💻"
                      Command="{Binding OpenInTerminalCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <!-- Open with Code -->
            <MenuItem Header="Open with Code"
                      Icon="⚡"
                      Command="{Binding OpenWithCodeCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <Separator Style="{StaticResource ModernMenuSeparatorStyle}" />

            <!-- Show more options -->
            <MenuItem Header="Show more options"
                      InputGestureText="Shift+F10"
                      Icon="↗"
                      Command="{Binding OpenPropertiesCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />
        </ContextMenu>

        <!-- ContextMenu for Empty Space in File List -->
        <ContextMenu x:Key="ModernPaneBackgroundContextMenu" Style="{StaticResource ModernContextMenuStyle}">
            <MenuItem Header="Refresh"
                      InputGestureText="F5"
                      Icon="🔄"
                      Command="{Binding RefreshCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <MenuItem Header="New folder"
                      InputGestureText="Ctrl+Shift+N"
                      Icon="📁"
                      Command="{Binding NewFolderCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <MenuItem Header="Paste"
                      InputGestureText="Ctrl+V"
                      Icon="📋"
                      Command="{Binding PasteCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <Separator Style="{StaticResource ModernMenuSeparatorStyle}" />

            <MenuItem Header="Open in Terminal"
                      Icon="💻"
                      Command="{Binding OpenInTerminalCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <MenuItem Header="Copy path"
                      Icon="📄"
                      Command="{Binding CopyPathCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />

            <MenuItem Header="Properties"
                      InputGestureText="Alt+Enter"
                      Icon="🔧"
                      Command="{Binding OpenPropertiesCommand}"
                      Style="{StaticResource ModernMenuItemStyle}" />
        </ContextMenu>
    </UserControl.Resources>

    <!-- Outer card container with active pane accent border and rounded corners -->
    <Border x:Name="PaneBorder"
            Background="#FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Margin="2"
            AllowDrop="True"
            PreviewDragEnter="OnPaneDragEnter"
            PreviewDragOver="OnPaneDragOver"
            PreviewDragLeave="OnPaneDragLeave"
            PreviewDrop="OnPaneDrop"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#E5E7EB" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="#D92662" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Row 0: Tab Bar & Quick Splits -->
                <RowDefinition Height="Auto" /> <!-- Row 1: Breadcrumb Navigation Trail -->
                <RowDefinition Height="Auto" /> <!-- Row 2: Progress Indicator -->
                <RowDefinition Height="Auto" /> <!-- Row 3: Error Banner -->
                <RowDefinition Height="*" />    <!-- Row 4: Main Content (Details / Icons / Preview) -->
                <RowDefinition Height="Auto" /> <!-- Row 5: Status Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Tab Header Bar -->
            <Border Grid.Row="0"
                    Background="#FAFAFA"
                    BorderBrush="#F3F4F6"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Tab Capsule -->
                        <ColumnDefinition Width="*" />    <!-- Spacer -->
                        <ColumnDefinition Width="Auto" /> <!-- View Modes & Splits -->
                    </Grid.ColumnDefinitions>

                    <!-- Tab Capsule for Current Folder (Draggable to dock) -->
                    <Border x:Name="TabCapsuleBorder"
                            Grid.Column="0"
                            Background="#FFFFFF"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,3"
                            ToolTip="Drag tab to an edge of any pane to dock it"
                            PreviewMouseLeftButtonDown="OnTabPreviewMouseLeftButtonDown"
                            PreviewMouseMove="OnTabPreviewMouseMove"
                            PreviewMouseLeftButtonUp="OnTabPreviewMouseLeftButtonUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FECDD3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Rose folder icon -->
                            <TextBlock Text="📁" FontSize="11" Foreground="#D92662" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CurrentFolderName}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center"
                                       MaxWidth="160"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Close tab / close pane button -->
                            <Button Command="{Binding DataContext.ClosePaneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Close Pane"
                                    Width="16" Height="16"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="✕" FontSize="9"
                                    Foreground="#9CA3AF"
                                    Cursor="Hand"
                                    Visibility="{Binding DataContext.CanClosePanes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Right Controls: View Modes & Pane Splitters -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- View Modes Segmented Control -->
                        <Border Background="#F3F4F6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="1"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SetViewModeCommand}" CommandParameter="Details"
                                        ToolTip="Details List View"
                                        Style="{StaticResource SubtleToolButton}"
                                        Height="20" Width="22" Padding="0"
                                        Content="≡" FontSize="11" />
                                <Button Command="{Binding SetViewModeCommand}" CommandParameter="Icons"
                                        ToolTip="Icons / Grid View"
                                        Style="{StaticResource SubtleToolButton}"
                                        Height="20" Width="22" Padding="0"
                                        Content="⊞" FontSize="10" />
                                <Button Command="{Binding SetViewModeCommand}" CommandParameter="Preview"
                                        ToolTip="Preview / Inspector View"
                                        Style="{StaticResource SubtleToolButton}"
                                        Height="20" Width="22" Padding="0"
                                        Content="▯" FontSize="10" />
                            </StackPanel>
                        </Border>

                        <!-- Split & Close Actions -->
                        <Button Command="{Binding DataContext.SplitVerticalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Split Right (+)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="22" Margin="1"
                                Content="+" FontSize="13" FontWeight="Bold" />

                        <Button Command="{Binding DataContext.SplitVerticalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Split Vertical (◫)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="22" Margin="1"
                                Content="◫" FontSize="11" />

                        <Button Command="{Binding DataContext.SplitHorizontalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Split Horizontal (⬒)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="22" Margin="1"
                                Content="⬒" FontSize="11" />

                        <Button Command="{Binding DataContext.ClosePaneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Close Pane"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="22" Margin="1"
                                Content="✕" FontSize="10" Foreground="#DC2626"
                                Visibility="{Binding DataContext.CanClosePanes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Breadcrumb Path Bar & Pane Actions -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#F3F4F6"
                    BorderThickness="0,0,0,1"
                    Padding="8,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Navigation Buttons (Back/Forward/Up) -->
                        <ColumnDefinition Width="*" />    <!-- Breadcrumb or Editable Address -->
                        <ColumnDefinition Width="Auto" /> <!-- Pane Action Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Command="{Binding GoBackCommand}"
                                ToolTip="Back (Alt+Left)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="22" Height="22" Margin="1"
                                Content="‹" FontSize="13" FontWeight="Bold" />
                        <Button Command="{Binding GoForwardCommand}"
                                ToolTip="Forward (Alt+Right)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="22" Height="22" Margin="1"
                                Content="›" FontSize="13" FontWeight="Bold" />
                        <Button Command="{Binding GoUpCommand}"
                                ToolTip="Up to Parent (Backspace)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="22" Height="22" Margin="1"
                                Content="▲" FontSize="9" />
                    </StackPanel>

                    <!-- Middle: Clickable Breadcrumbs when NOT editing -->
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsEditingAddress, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Drive / Root icon -->
                            <TextBlock Text="📁" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0" />

                            <!-- Breadcrumb segments list -->
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:BreadcrumbItem}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Segment Button (Click to navigate, Right-click for options) -->
                                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FullPath}"
                                                    ToolTip="{Binding FullPath}"
                                                    Style="{StaticResource CrumbButtonStyle}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource BreadcrumbSegmentContextMenuStyle}">
                                                        <MenuItem Header="Open" Click="OnOpenSegmentClick" Style="{StaticResource BreadcrumbSegmentMenuItemStyle}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="📂" FontSize="11" Foreground="#374151" VerticalAlignment="Center" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Open in New Tab" Click="OnOpenSegmentInNewTabClick" Style="{StaticResource BreadcrumbSegmentMenuItemStyle}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="⊞" FontSize="11" Foreground="#374151" VerticalAlignment="Center" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Background="#F3F4F6" Margin="4,2" Height="1" />
                                                        <MenuItem Header="Copy as Pathname" Click="OnCopySegmentPathnameClick" Style="{StaticResource BreadcrumbSegmentMenuItemStyle}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="📋" FontSize="11" Foreground="#374151" VerticalAlignment="Center" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <TextBlock Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#374151" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D92662" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D92662" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>

                                            <!-- Chevron dropdown button after each segment -->
                                            <Button Style="{StaticResource CrumbChevronButtonStyle}"
                                                    Click="OnBreadcrumbChevronClick"
                                                    ToolTip="List folders inside (click to open)">
                                                <TextBlock Text="›" FontSize="12" Margin="1,-1,1,1" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Edit Pencil Button to switch to Address bar -->
                            <Button Command="{Binding StartEditingAddressCommand}"
                                    ToolTip="Edit Path"
                                    Style="{StaticResource SubtleToolButton}"
                                    Width="20" Height="20" Margin="4,0,0,0"
                                    Content="✎" FontSize="9" Foreground="#9CA3AF" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Middle: Editable Address Box when editing -->
                    <Grid Grid.Column="1"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsEditingAddress, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="AddressTextBox"
                                 Grid.Column="0"
                                 Height="24"
                                 VerticalContentAlignment="Center"
                                 Padding="4,0"
                                 FontSize="11"
                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnAddressTextBoxKeyDown" />

                        <Button Grid.Column="1"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding AddressText}"
                                ToolTip="Go (Enter)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="24" Height="24" Margin="2,0,0,0"
                                Content="➔" FontSize="11" />

                        <Button Grid.Column="2"
                                Command="{Binding StopEditingAddressCommand}"
                                ToolTip="Cancel (Esc)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="24" Height="24" Margin="2,0,0,0"
                                Content="✕" FontSize="10" Foreground="#6B7280" />
                    </Grid>

                    <!-- Right Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}"
                                ToolTip="Refresh (F5)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="24" Height="22" Margin="1"
                                Content="↻" FontSize="12" />

                        <Button Command="{Binding NewFolderCommand}"
                                ToolTip="New Folder (Ctrl+Shift+N)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="26" Height="22" Margin="1"
                                Content="📁+" FontSize="10" />

                        <Button Command="{Binding RenameCommand}"
                                ToolTip="Rename (F2)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="24" Height="22" Margin="1"
                                Content="✎" FontSize="10" />

                        <Button Command="{Binding UndoCommand}"
                                ToolTip="Undo (Ctrl+Z)"
                                Style="{StaticResource SubtleToolButton}"
                                Width="24" Height="22" Margin="1"
                                Content="↶" FontSize="11" />

                        <Button Command="{Binding DataContext.CopyToOtherPaneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Copy to other pane (Ctrl+Shift+C)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Padding="4,0" Margin="1"
                                Content="📋➔" FontSize="10" />

                        <Button Command="{Binding DataContext.MoveToOtherPaneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Move to other pane (Ctrl+Shift+M)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Padding="4,0" Margin="1"
                                Content="✂➔" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Progress Indicator -->
            <ProgressBar Grid.Row="2"
                         Height="2"
                         BorderThickness="0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Foreground="#D92662"
                         Background="Transparent" />

            <!-- Row 3: Inline Error Banner -->
            <Border Grid.Row="3"
                    Margin="4,2"
                    Padding="8,4"
                    Background="#FEF2F2"
                    BorderBrush="#F87171"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorMessage}"
                               ToolTip="{Binding ErrorMessage}"
                               Foreground="#B91C1C"
                               VerticalAlignment="Center"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Command="{Binding DismissErrorCommand}"
                            Content="✕"
                            Width="20" Height="20"
                            Margin="4,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B91C1C"
                            Cursor="Hand" />
                </Grid>
            </Border>

            <!-- Row 4: Main Content Area (Mode 1: Details View, Mode 2: Icons View, Mode 3: Preview Inspector) -->
            <Grid Grid.Row="4" Margin="2">

                <!-- Mode 1: Detailed List View (Virtualized ListView) -->
                <ListView x:Name="FileListView"
                          FocusVisualStyle="{x:Null}"
                          ItemsSource="{Binding Items}"
                          SelectionMode="Extended"
                          AllowDrop="True"
                          SelectionChanged="OnFileListViewSelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          GridViewColumnHeader.Click="OnGridViewColumnHeaderClicked"
                          PreviewMouseLeftButtonDown="OnFileListViewPreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="OnFileListViewPreviewMouseLeftButtonUp"
                          PreviewMouseRightButtonDown="OnFileListViewPreviewMouseRightButtonDown"
                          MouseMove="OnFileListViewMouseMove"
                          DragEnter="OnFileListViewDragEnter"
                          DragOver="OnFileListViewDragOver"
                          DragLeave="OnFileListViewDragLeave"
                          Drop="OnFileListViewDrop"
                          MouseDoubleClick="OnFileListViewMouseDoubleClick"
                          KeyDown="OnFileListViewKeyDown"
                          ContextMenuOpening="OnListViewContextMenuOpening"
                          ContextMenu="{StaticResource ModernPaneBackgroundContextMenu}"
                          BorderThickness="0"
                          Visibility="{Binding ViewMode, Converter={StaticResource EqToVis}, ConverterParameter=Details}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="ContextMenu" Value="{StaticResource ModernFileItemContextMenu}" />
                            <EventSetter Event="ContextMenuOpening" Handler="OnItemContextMenuOpening" />
                            <Setter Property="Opacity" Value="{Binding Opacity}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <GridViewRowPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#F1F5F9" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FDF2F4" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FECDD3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <!-- Name Column with Shell Icon -->
                            <GridViewColumn Width="260">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Name" Tag="Name" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Width="16" Height="16"
                                                   Margin="0,0,6,0"
                                                   Source="{Binding Icon}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Modified Column -->
                            <GridViewColumn Width="130">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Date Modified" Tag="Modified" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                        <TextBlock Text="{Binding FormattedModified}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#6B7280" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Size Column -->
                            <GridViewColumn Width="90">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Size" Tag="Size" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                        <TextBlock Text="{Binding FormattedSize}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#6B7280" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Type Column -->
                            <GridViewColumn Width="120">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Kind" Tag="Type" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                        <TextBlock Text="{Binding DisplayType}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#9CA3AF" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Mode 2: Icons / Grid View (matching bottom-right pane in reference) -->
                <ListView x:Name="IconsListView"
                          FocusVisualStyle="{x:Null}"
                          ItemsSource="{Binding Items}"
                          SelectionMode="Extended"
                          AllowDrop="True"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="OnFileListViewMouseDoubleClick"
                          KeyDown="OnFileListViewKeyDown"
                          SelectionChanged="OnFileListViewSelectionChanged"
                          PreviewMouseLeftButtonDown="OnFileListViewPreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="OnFileListViewPreviewMouseLeftButtonUp"
                          PreviewMouseRightButtonDown="OnFileListViewPreviewMouseRightButtonDown"
                          MouseMove="OnFileListViewMouseMove"
                          DragEnter="OnFileListViewDragEnter"
                          DragOver="OnFileListViewDragOver"
                          DragLeave="OnFileListViewDragLeave"
                          Drop="OnFileListViewDrop"
                          ContextMenuOpening="OnListViewContextMenuOpening"
                          ContextMenu="{StaticResource ModernPaneBackgroundContextMenu}"
                          Visibility="{Binding ViewMode, Converter={StaticResource EqToVis}, ConverterParameter=Icons}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="ContextMenu" Value="{StaticResource ModernFileItemContextMenu}" />
                            <EventSetter Event="ContextMenuOpening" Handler="OnItemContextMenuOpening" />
                            <Setter Property="Width" Value="86" />
                            <Setter Property="Height" Value="92" />
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Opacity" Value="{Binding Opacity}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="bd"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                CornerRadius="6"
                                                Padding="4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6" />
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#E5E7EB" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FDF2F4" />
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FECDD3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0"
                                       Width="48" Height="48"
                                       Source="{Binding Icon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Name}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#1F2937"
                                           MaxWidth="78"
                                           Margin="0,2,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Mode 3: Preview Inspector View (matching top-left pane in reference) -->
                <Grid Visibility="{Binding ViewMode, Converter={StaticResource EqToVis}, ConverterParameter=Preview}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />    <!-- Large Preview Area & Filmstrip -->
                        <ColumnDefinition Width="220" />  <!-- Information Sidebar Card -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Large Preview + Carousel Filmstrip -->
                    <Grid Grid.Column="0" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />    <!-- Large Preview Hero Box -->
                            <RowDefinition Height="Auto" /> <!-- Selected File Title -->
                            <RowDefinition Height="74" />   <!-- Filmstrip Carousel -->
                        </Grid.RowDefinitions>

                        <!-- Large Preview Hero Box -->
                        <Border Grid.Row="0"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="4">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="180" Height="180"
                                       Source="{Binding SelectedItemIcon}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <!-- Selected File Title -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding SelectedItemName}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,4"
                                   Foreground="#1F2937" />

                        <!-- Filmstrip Carousel of files in folder -->
                        <ListView Grid.Row="2"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <Border Width="60" Height="60"
                                            Background="#FFFFFF"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="2"
                                            Padding="4">
                                        <Grid>
                                            <Image Width="36" Height="36"
                                                   Source="{Binding Icon}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Right: Information Sidebar Card (exact match to top-left pane) -->
                    <Border Grid.Column="1"
                            Background="#FAFAFA"
                            BorderBrush="#F3F4F6"
                            BorderThickness="1,0,0,0"
                            Padding="12,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Information" FontWeight="SemiBold" FontSize="13" Foreground="#111827" />
                                    <TextBlock Text="Show More" FontSize="10" Foreground="#2563EB" HorizontalAlignment="Right" Cursor="Hand" />
                                </Grid>

                                <!-- File Icon + Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Image Width="32" Height="32"
                                           Source="{Binding SelectedItemIcon}"
                                           Margin="0,0,8,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedItemName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="150" Foreground="#111827" />
                                        <TextBlock Text="{Binding SelectedItemType}" FontSize="10" Foreground="#6B7280" />
                                        <TextBlock Text="{Binding SelectedItemSize}" FontSize="10" Foreground="#6B7280" />
                                    </StackPanel>
                                </StackPanel>

                                <Separator Background="#E5E7EB" Margin="0,4,0,8" />

                                <!-- Metadata Grid -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Modified" FontSize="10" Foreground="#6B7280" Margin="0,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItemModified}" FontSize="10" Foreground="#111827" Margin="0,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" FontSize="10" Foreground="#6B7280" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItemSize}" FontSize="10" Foreground="#111827" Margin="0,2" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Path" FontSize="10" Foreground="#6B7280" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItemPath}" FontSize="9" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,2" />
                                </Grid>

                                <Separator Background="#E5E7EB" Margin="0,12,0,10" />

                                <!-- Quick Actions (Rotate / Open / Delete) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                                    <Button Command="{Binding OpenItemCommand}"
                                            CommandParameter="{Binding SelectedItem}"
                                            ToolTip="Open File"
                                            Style="{StaticResource SubtleToolButton}"
                                            Height="26" Padding="8,2" Margin="2"
                                            Content="Open" FontSize="11" />

                                    <Button Command="{Binding DeleteToRecycleBinCommand}"
                                            ToolTip="Delete to Recycle Bin"
                                            Style="{StaticResource SubtleToolButton}"
                                            Height="26" Padding="8,2" Margin="2"
                                            Content="Delete" FontSize="11" Foreground="#DC2626" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Row 5: Status Footer -->
            <Border Grid.Row="5"
                    Background="#FAFAFA"
                    BorderBrush="#F3F4F6"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="8,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectionStatusText}"
                               FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SortStatusText}"
                               FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Dock Preview Overlay (Visible during Tab Drag-to-Dock or Center-to-Swap) -->
            <Border x:Name="DockPreviewOverlay"
                    Grid.Row="0" Grid.RowSpan="6"
                    Background="#26D92662"
                    BorderBrush="#D92662"
                    BorderThickness="2"
                    CornerRadius="8"
                    Margin="3"
                    IsHitTestVisible="False"
                    AllowDrop="False"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#D92662" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <Border x:Name="DockPreviewBadge"
                        Background="#D92662"
                        CornerRadius="16"
                        Padding="14,7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.30"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⇄" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hoán đổi vị trí" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>