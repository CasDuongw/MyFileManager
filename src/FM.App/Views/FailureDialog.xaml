<Window x:Class="FM.App.Views.FailureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Transfer Error"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F9FAFB"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="An error occurred during file transfer"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#B91C1C" />
            <TextBlock x:Name="AttemptText"
                       Text="Attempt #1"
                       FontSize="12" Foreground="#6B7280"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Details Card -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="File Path:" FontSize="11.5" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBlock x:Name="FilePathText"
                           FontSize="12" Foreground="#111827"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,8" />

                <TextBlock Text="Error:" FontSize="11.5" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBlock x:Name="ErrorMessageText"
                           FontSize="12" Foreground="#DC2626"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Checkbox: Apply to all -->
        <CheckBox x:Name="ApplyToAllCheckBox"
                  Grid.Row="2"
                  Content="Do this for all remaining errors"
                  FontSize="12"
                  Margin="2,0,0,14" />

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="RetryButton"
                    Content="Retry"
                    Width="75" Height="28"
                    Margin="0,0,6,0"
                    IsDefault="True"
                    Background="#0078D4" Foreground="White" BorderThickness="0"
                    Click="OnRetryClicked" />
            <Button x:Name="SkipButton"
                    Content="Skip"
                    Width="75" Height="28"
                    Margin="0,0,6,0"
                    Click="OnSkipClicked" />
            <Button x:Name="AbortButton"
                    Content="Abort"
                    Width="75" Height="28"
                    IsCancel="True"
                    Click="OnAbortClicked" />
        </StackPanel>
    </Grid>
</Window>
