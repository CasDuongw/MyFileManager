<UserControl x:Class="FM.App.Views.TransferDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:FM.App.ViewModels"
             xmlns:models="clr-namespace:FM.Core.Operations.Transfer;assembly=FM.Core"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TransferDrawerViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="DrawerActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasJobs}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="#F9FAFB">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Collapsed bar / header (always visible when drawer has jobs) -->
                <RowDefinition Height="32" />
                <!-- Expanded job list -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Collapsed bar / Header row -->
            <Grid Grid.Row="0" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <TextBlock Grid.Column="0"
                           Text="⇄"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#0078D4"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Summary Text -->
                <TextBlock Grid.Column="1"
                           Text="{Binding SummaryText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Clear finished button -->
                <Button Grid.Column="2"
                        Content="Clear finished"
                        Style="{StaticResource DrawerActionButtonStyle}"
                        Command="{Binding ClearFinishedCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />

                <!-- Expand / Collapse Toggle Button -->
                <Button Grid.Column="3"
                        Style="{StaticResource DrawerActionButtonStyle}"
                        Command="{Binding ToggleExpandedCommand}"
                        VerticalAlignment="Center"
                        Padding="6,2">
                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#4B5563">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="▲" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="▼" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <!-- Expanded Job List -->
            <Border Grid.Row="1"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Background="#FFFFFF"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="260"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Jobs}" Margin="6,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TransferJobViewModel}">
                                <Border Margin="0,3"
                                        Padding="8"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top row: Kind + Title + Actions -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#111827"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Controls -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Pause"
                                                        Style="{StaticResource DrawerActionButtonStyle}"
                                                        Command="{Binding PauseCommand}"
                                                        Visibility="{Binding PauseCommand.CanExecute, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="Resume"
                                                        Style="{StaticResource DrawerActionButtonStyle}"
                                                        Command="{Binding ResumeCommand}"
                                                        Visibility="{Binding ResumeCommand.CanExecute, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="Cancel"
                                                        Style="{StaticResource DrawerActionButtonStyle}"
                                                        Command="{Binding CancelCommand}"
                                                        Visibility="{Binding CancelCommand.CanExecute, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Current file -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding CurrentFile}"
                                                   ToolTip="{Binding CurrentFile}"
                                                   FontSize="11"
                                                   Foreground="#6B7280"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,4" />

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Row="2"
                                                     Height="5"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Percent, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                     Foreground="#0078D4"
                                                     Background="#E5E7EB"
                                                     BorderThickness="0"
                                                     Margin="0,0,0,4" />

                                        <!-- Progress Text -->
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding ProgressText}"
                                                   FontSize="11"
                                                   Foreground="#4B5563" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
