<Window x:Class="FM.App.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FM.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConflictDialogViewModel}"
        Title="File Conflict"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F9FAFB"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Comparison Cards -->
            <RowDefinition Height="Auto" /> <!-- Dynamic Banner -->
            <RowDefinition Height="Auto" /> <!-- Checkbox -->
            <RowDefinition Height="Auto" /> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="A file with this name already exists"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding FileName}"
                       FontSize="13.5" FontWeight="Medium"
                       Foreground="#4B5563"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Comparison Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Source Card (Incoming) -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Incoming (Source)"
                               FontWeight="SemiBold" FontSize="12.5"
                               Foreground="#1F2937"
                               Margin="0,0,0,8" />

                    <!-- Thumbnail & Path -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Border Width="64" Height="64"
                                Background="#F3F4F6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,10,0">
                            <Image Source="{Binding SourceThumbnail}"
                                   AutomationProperties.Name="Incoming file thumbnail"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="In folder:" FontSize="11" Foreground="#6B7280" />
                            <TextBlock Text="{Binding SourceDirectory}"
                                       ToolTip="{Binding SourceDirectory}"
                                       FontSize="11.5" Foreground="#374151"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Details: Size and Date -->
                    <StackPanel Grid.Row="2">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Size: " FontSize="11.5" Foreground="#6B7280" />
                            <TextBlock Text="{Binding SourceSizeText}" FontSize="11.5" Foreground="#111827" FontWeight="Medium" />
                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#DBEAFE"
                                    Visibility="{Binding SourceIsLarger, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Larger" FontSize="10" FontWeight="SemiBold" Foreground="#1E40AF"
                                           AutomationProperties.Name="Incoming file is larger" />
                            </Border>
                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#F3F4F6"
                                    Visibility="{Binding DestIsLarger, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Smaller" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                                           AutomationProperties.Name="Incoming file is smaller" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Modified: " FontSize="11.5" Foreground="#6B7280" />
                            <TextBlock Text="{Binding SourceModifiedText}" FontSize="11.5" Foreground="#111827" FontWeight="Medium" />
                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#DCFCE7"
                                    Visibility="{Binding SourceIsNewer, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Newer" FontSize="10" FontWeight="SemiBold" Foreground="#166534"
                                           AutomationProperties.Name="Incoming file is newer" />
                            </Border>
                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#F3F4F6"
                                    Visibility="{Binding DestIsNewer, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Older" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                                           AutomationProperties.Name="Incoming file is older" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Destination Card (Existing) -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Existing (Destination)"
                               FontWeight="SemiBold" FontSize="12.5"
                               Foreground="#1F2937"
                               Margin="0,0,0,8" />

                    <!-- Thumbnail & Path -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Border Width="64" Height="64"
                                Background="#F3F4F6"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,10,0">
                            <Image Source="{Binding DestThumbnail}"
                                   AutomationProperties.Name="Existing file thumbnail"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="In folder:" FontSize="11" Foreground="#6B7280" />
                            <TextBlock Text="{Binding DestDirectory}"
                                       ToolTip="{Binding DestDirectory}"
                                       FontSize="11.5" Foreground="#374151"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Details: Size and Date -->
                    <StackPanel Grid.Row="2">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Size: " FontSize="11.5" Foreground="#6B7280" />
                            <TextBlock Text="{Binding DestSizeText}" FontSize="11.5" Foreground="#111827" FontWeight="Medium" />
                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#DBEAFE"
                                    Visibility="{Binding DestIsLarger, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Larger" FontSize="10" FontWeight="SemiBold" Foreground="#1E40AF"
                                           AutomationProperties.Name="Existing file is larger" />
                            </Border>
                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#F3F4F6"
                                    Visibility="{Binding SourceIsLarger, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Smaller" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                                           AutomationProperties.Name="Existing file is smaller" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Modified: " FontSize="11.5" Foreground="#6B7280" />
                            <TextBlock Text="{Binding DestModifiedText}" FontSize="11.5" Foreground="#111827" FontWeight="Medium" />
                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#DCFCE7"
                                    Visibility="{Binding DestIsNewer, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Newer" FontSize="10" FontWeight="SemiBold" Foreground="#166534"
                                           AutomationProperties.Name="Existing file is newer" />
                            </Border>
                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                    Background="#F3F4F6"
                                    Visibility="{Binding SourceIsNewer, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Older" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                                           AutomationProperties.Name="Existing file is older" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Dynamic Banner -->
        <Border Grid.Row="2"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#10B981" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerIsWarning}" Value="True">
                            <Setter Property="Background" Value="#FEF3C7" />
                            <Setter Property="BorderBrush" Value="#F59E0B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="🛡️" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BannerIsWarning}" Value="True">
                                    <Setter Property="Text" Value="⚠️" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding BannerText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#065F46" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BannerIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="#92400E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Checkbox: Apply to all -->
        <CheckBox Grid.Row="3"
                  IsChecked="{Binding ApplyToAll}"
                  Content="_Do this for all remaining conflicts"
                  FontSize="12"
                  Margin="2,0,0,14" />

        <!-- Buttons with Access Keys -->
        <StackPanel Grid.Row="4"
                    Orientation="Vertical"
                    HorizontalAlignment="Right">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="KeepBothButton"
                        Content="_Keep both"
                        ToolTip="Keep both files by renaming incoming file (e.g. name (2).ext)"
                        Padding="12,6" Margin="4"
                        IsDefault="True"
                        Background="#0078D4" Foreground="White" BorderThickness="0"
                        Click="OnKeepBothClicked" />

                <StackPanel Orientation="Vertical">
                    <Button Content="Overwrite _if newer"
                            ToolTip="Overwrite existing file only if incoming file is newer"
                            Padding="12,6" Margin="4"
                            Click="OnOverwriteIfNewerClicked" />
                    <TextBlock Text="{Binding OverwriteIfNewerHint}"
                               FontSize="10.5" Foreground="#6B7280"
                               HorizontalAlignment="Center" Margin="0,0,0,2" />
                </StackPanel>

                <Button Content="_Overwrite"
                        ToolTip="Replace existing file with incoming file"
                        Padding="12,6" Margin="4"
                        Click="OnOverwriteClicked" />

                <Button Content="_Skip"
                        ToolTip="Do not transfer this file"
                        Padding="12,6" Margin="4"
                        Click="OnSkipClicked" />

                <Button Content="_Cancel"
                        ToolTip="Cancel the entire transfer operation"
                        Padding="12,6" Margin="4"
                        IsCancel="True"
                        Click="OnCancelClicked" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
