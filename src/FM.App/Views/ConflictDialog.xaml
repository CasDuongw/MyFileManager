<Window x:Class="FM.App.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Conflict"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F9FAFB"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="A file with this name already exists"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock x:Name="FileNameText"
                       Text="file.ext"
                       FontSize="13" FontWeight="Medium"
                       Foreground="#4B5563"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Comparison Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Source Card (Incoming) -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Source (Incoming)"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="#1F2937"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Size: " FontSize="11.5" Foreground="#6B7280" />
                        <TextBlock x:Name="SourceSizeText" FontSize="11.5" Foreground="#111827" />
                        <Border x:Name="SourceSizeBadge" Margin="6,0,0,0" Padding="4,1" CornerRadius="3" Visibility="Collapsed">
                            <TextBlock x:Name="SourceSizeBadgeText" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Date: " FontSize="11.5" Foreground="#6B7280" />
                        <TextBlock x:Name="SourceModifiedText" FontSize="11.5" Foreground="#111827" />
                        <Border x:Name="SourceDateBadge" Margin="6,0,0,0" Padding="4,1" CornerRadius="3" Visibility="Collapsed">
                            <TextBlock x:Name="SourceDateBadgeText" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Destination Card (Existing) -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Destination (Existing)"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="#1F2937"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Size: " FontSize="11.5" Foreground="#6B7280" />
                        <TextBlock x:Name="DestSizeText" FontSize="11.5" Foreground="#111827" />
                        <Border x:Name="DestSizeBadge" Margin="6,0,0,0" Padding="4,1" CornerRadius="3" Visibility="Collapsed">
                            <TextBlock x:Name="DestSizeBadgeText" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Date: " FontSize="11.5" Foreground="#6B7280" />
                        <TextBlock x:Name="DestModifiedText" FontSize="11.5" Foreground="#111827" />
                        <Border x:Name="DestDateBadge" Margin="6,0,0,0" Padding="4,1" CornerRadius="3" Visibility="Collapsed">
                            <TextBlock x:Name="DestDateBadgeText" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Warning Alert Banner -->
        <Border Grid.Row="2"
                Background="#FEF3C7"
                BorderBrush="#F59E0B"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10,6"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Overwritten files cannot be restored with Undo (backup staging planned for v0.4)."
                           FontSize="11.5" Foreground="#92400E" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Checkbox: Apply to all -->
        <CheckBox x:Name="ApplyToAllCheckBox"
                  Grid.Row="3"
                  Content="Do this for all remaining conflicts"
                  FontSize="12"
                  Margin="2,0,0,14" />

        <!-- Buttons -->
        <WrapPanel Grid.Row="4"
                   HorizontalAlignment="Right"
                   Orientation="Horizontal">
            <Button x:Name="KeepBothButton"
                    Content="Keep Both"
                    ToolTip="Keep both files by renaming incoming file (e.g. name (1).ext)"
                    Padding="10,5" Margin="3"
                    IsDefault="True"
                    Background="#0078D4" Foreground="White" BorderThickness="0"
                    Click="OnKeepBothClicked" />
            <Button x:Name="OverwriteIfNewerButton"
                    Content="Overwrite If Newer"
                    ToolTip="Overwrite existing file only if incoming file is newer"
                    Padding="10,5" Margin="3"
                    Click="OnOverwriteIfNewerClicked" />
            <Button x:Name="OverwriteButton"
                    Content="Overwrite"
                    ToolTip="Replace existing file with incoming file"
                    Padding="10,5" Margin="3"
                    Click="OnOverwriteClicked" />
            <Button x:Name="SkipButton"
                    Content="Skip"
                    ToolTip="Do not transfer this file"
                    Padding="10,5" Margin="3"
                    Click="OnSkipClicked" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    ToolTip="Cancel the entire transfer operation"
                    Padding="10,5" Margin="3"
                    IsCancel="True"
                    Click="OnCancelClicked" />
        </WrapPanel>
    </Grid>
</Window>

