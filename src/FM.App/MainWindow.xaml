<Window x:Class="FM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FM.App.ViewModels"
        xmlns:views="clr-namespace:FM.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MyFileManager"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="450"
        Background="#F3F4F6"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Sidebar Item Style -->
        <Style x:Key="SidebarItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Item Data Template -->
        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type vm:SidebarItemViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="16" Height="16"
                       Margin="0,0,8,0"
                       Source="{Binding Icon}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Name}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header / Layout Switcher Bar -->
            <RowDefinition Height="*" />    <!-- Main Content (Sidebar + Panes Workspace) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Transfer Drawer -->
        </Grid.RowDefinitions>

        <!-- Top Header / Layout Switcher Bar -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Navigation (Back/Forward) -->
                    <ColumnDefinition Width="Auto" /> <!-- Active Folder Title -->
                    <ColumnDefinition Width="*" />    <!-- Spacer -->
                    <ColumnDefinition Width="Auto" /> <!-- View Modes (Icons/List/Preview) -->
                    <ColumnDefinition Width="Auto" /> <!-- Layout Switcher Presets -->
                    <ColumnDefinition Width="Auto" /> <!-- Actions (+Split, ⇄ Switch, 👁 Hidden) -->
                    <ColumnDefinition Width="Auto" /> <!-- Search Box Capsule -->
                </Grid.ColumnDefinitions>

                <!-- Navigation Back / Forward Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Command="{Binding ActivePane.GoBackCommand}"
                            ToolTip="Back (Alt+Left)"
                            Style="{StaticResource SubtleToolButton}"
                            Width="26" Height="26" Margin="1"
                            Content="‹" FontSize="16" FontWeight="Bold" />
                    <Button Command="{Binding ActivePane.GoForwardCommand}"
                            ToolTip="Forward (Alt+Right)"
                            Style="{StaticResource SubtleToolButton}"
                            Width="26" Height="26" Margin="1"
                            Content="›" FontSize="16" FontWeight="Bold" />
                </StackPanel>

                <!-- Active Folder Title -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveFolderName}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#111827"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center/Right: View Modes Segmented Control -->
                <Border Grid.Column="3"
                        Background="#F3F4F6"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SetGlobalViewModeCommand}" CommandParameter="Icons"
                                ToolTip="Icons / Grid View"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="26" Padding="0"
                                Content="⊞" FontSize="11" />
                        <Button Command="{Binding SetGlobalViewModeCommand}" CommandParameter="Details"
                                ToolTip="Details List View"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="26" Padding="0"
                                Content="≡" FontSize="13" />
                        <Button Command="{Binding SetGlobalViewModeCommand}" CommandParameter="Preview"
                                ToolTip="Preview / Inspector View"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="26" Padding="0"
                                Content="▯" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Multi-Pane Layout Presets Segmented Control -->
                <Border Grid.Column="4"
                        Background="#F3F4F6"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SetLayoutCommand}" CommandParameter="Single"
                                ToolTip="Single Pane (Ctrl+Shift+1)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="24" Padding="0"
                                Content="1" FontSize="11" FontWeight="SemiBold" />
                        <Button Command="{Binding SetLayoutCommand}" CommandParameter="DualVertical"
                                ToolTip="2 Columns (Ctrl+Shift+2)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="24" Padding="0"
                                Content="◫" FontSize="11" />
                        <Button Command="{Binding SetLayoutCommand}" CommandParameter="DualHorizontal"
                                ToolTip="2 Rows (Ctrl+Shift+3)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="24" Padding="0"
                                Content="⬒" FontSize="11" />
                        <Button Command="{Binding SetLayoutCommand}" CommandParameter="TripleLeft"
                                ToolTip="Triple Layout (1 Left, 2 Right)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="24" Padding="0"
                                Content="◫+" FontSize="9" />
                        <Button Command="{Binding SetLayoutCommand}" CommandParameter="QuadGrid"
                                ToolTip="Quad Grid 2x2 (Ctrl+Shift+4)"
                                Style="{StaticResource SubtleToolButton}"
                                Height="22" Width="24" Padding="0"
                                Content="⊞" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Actions (+Split, ⇄ Switch, 👁 Hidden) -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Command="{Binding SplitVerticalCommand}"
                            ToolTip="Add Split Pane (Ctrl+Shift+T)"
                            Style="{StaticResource SubtleToolButton}"
                            Height="26" Padding="6,0" Margin="1"
                            Content="+ Split" FontSize="11" />
                    <Button Command="{Binding SwitchActivePaneCommand}"
                            ToolTip="Switch Active Pane (Tab)"
                            Style="{StaticResource SubtleToolButton}"
                            Height="26" Padding="6,0" Margin="2,1"
                            Content="⇄ Switch" FontSize="11" />
                    <Button Command="{Binding ToggleHiddenFilesCommand}"
                            ToolTip="Toggle Hidden Files (Ctrl+H)"
                            Style="{StaticResource SubtleToolButton}"
                            Height="26" Padding="6,0" Margin="1"
                            Content="👁 Hidden" FontSize="11" />
                </StackPanel>

                <!-- Modern Search Capsule -->
                <Border Grid.Column="6"
                        Background="#F3F4F6"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="13"
                        Height="26" Width="150"
                        Padding="8,0"
                        VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="ToolbarFilterBox"
                                 Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 Foreground="#111827"
                                 PreviewKeyDown="OnToolbarFilterBoxPreviewKeyDown" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace (Sidebar + Multi-Pane Workspace) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="190" MinWidth="130" MaxWidth="320" />
                <!-- Splitter between Sidebar and File Panes -->
                <ColumnDefinition Width="4" />
                <!-- Multi-Pane Content -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,1,0"
                    Padding="6,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Favorites Group -->
                        <TextBlock Text="FAVORITES"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#9CA3AF"
                                   Margin="8,4,8,4" />

                        <ListBox ItemsSource="{Binding SidebarFavorites}"
                                 ItemTemplate="{StaticResource SidebarItemTemplate}"
                                 ItemContainerStyle="{StaticResource SidebarItemContainerStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="OnSidebarSelectionChanged" />

                        <!-- Divider -->
                        <Separator Margin="6,10" Background="#E5E7EB" />

                        <!-- Drives Group -->
                        <TextBlock Text="DRIVES"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#9CA3AF"
                                   Margin="8,4,8,4" />

                        <ListBox ItemsSource="{Binding SidebarDrives}"
                                 ItemTemplate="{StaticResource SidebarItemTemplate}"
                                 ItemContainerStyle="{StaticResource SidebarItemContainerStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="OnSidebarSelectionChanged" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Splitter for Sidebar -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E5E7EB"
                          ShowsPreview="False" />

            <!-- Dynamic Multi-Pane Workspace -->
            <views:MultiPaneWorkspace x:Name="WorkspaceControl"
                                      Grid.Column="2"
                                      Margin="4" />
        </Grid>

        <!-- Bottom Transfer Drawer -->
        <views:TransferDrawerView Grid.Row="2" DataContext="{Binding TransferDrawer}" />

        <!-- Quick Open / Command Palette Overlay (Top Z-Index) -->
        <views:QuickOpenView Grid.Row="0" Grid.RowSpan="3" DataContext="{Binding QuickOpen}" Panel.ZIndex="1000" />
    </Grid>
</Window>
