<Window x:Class="FM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FM.App.ViewModels"
        xmlns:views="clr-namespace:FM.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MyFileManager"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="450"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Sidebar Item Style -->
        <Style x:Key="SidebarItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Item Data Template -->
        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type vm:SidebarItemViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="16" Height="16"
                       Margin="0,0,8,0"
                       Source="{Binding Icon}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Name}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="190" MinWidth="130" MaxWidth="320" />
            <!-- Splitter between Sidebar and File Panes -->
            <ColumnDefinition Width="4" />
            <!-- Dual Panes Content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0"
                Padding="6,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Favorites Group -->
                    <TextBlock Text="FAVORITES"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               Margin="8,4,8,4" />

                    <ListBox ItemsSource="{Binding SidebarFavorites}"
                             ItemTemplate="{StaticResource SidebarItemTemplate}"
                             ItemContainerStyle="{StaticResource SidebarItemContainerStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="OnSidebarSelectionChanged" />

                    <!-- Divider -->
                    <Separator Margin="6,10" Background="#E5E7EB" />

                    <!-- Drives Group -->
                    <TextBlock Text="DRIVES"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               Margin="8,4,8,4" />

                    <ListBox ItemsSource="{Binding SidebarDrives}"
                             ItemTemplate="{StaticResource SidebarItemTemplate}"
                             ItemContainerStyle="{StaticResource SidebarItemContainerStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="OnSidebarSelectionChanged" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Splitter for Sidebar -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#E5E7EB"
                      ShowsPreview="False" />

        <!-- Dual Pane Workspace -->
        <Grid Grid.Column="2" Margin="4">
            <Grid.ColumnDefinitions>
                <!-- Left Pane -->
                <ColumnDefinition Width="*" MinWidth="200" />
                <!-- GridSplitter between Panes -->
                <ColumnDefinition Width="6" />
                <!-- Right Pane -->
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane -->
            <views:FilePaneView x:Name="LeftPaneControl"
                                Grid.Column="0"
                                DataContext="{Binding LeftPane}" />

            <!-- GridSplitter between Left and Right Panes -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E5E7EB"
                          ShowsPreview="False"
                          Cursor="SizeWE" />

            <!-- Right Pane -->
            <views:FilePaneView x:Name="RightPaneControl"
                                Grid.Column="2"
                                DataContext="{Binding RightPane}" />
        </Grid>
    </Grid>
</Window>
