<Window x:Class="FM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FM.App.ViewModels"
        xmlns:views="clr-namespace:FM.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MyFileManager"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="450"
        Background="#F3F4F6"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Sidebar Item Style -->
        <Style x:Key="SidebarItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Item Data Template -->
        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type vm:SidebarItemViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="16" Height="16"
                       Margin="0,0,8,0"
                       Source="{Binding Icon}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Name}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header / Layout Switcher Bar -->
            <RowDefinition Height="*" />    <!-- Main Content (Sidebar + Panes Workspace) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Transfer Drawer -->
        </Grid.RowDefinitions>

        <!-- Top Header / Layout Switcher Bar -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Title / Brand -->
                    <ColumnDefinition Width="*" />    <!-- Spacer -->
                    <ColumnDefinition Width="Auto" /> <!-- Layout Controls -->
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁 MyFileManager" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Multi-Pane Layout Presets & Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Layout:" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <!-- Presets -->
                    <Button Command="{Binding SetLayoutCommand}" CommandParameter="Single"
                            ToolTip="Single Pane (Ctrl+Shift+1)"
                            Width="28" Height="26" Margin="1"
                            Content="1" FontSize="11" FontWeight="SemiBold" />

                    <Button Command="{Binding SetLayoutCommand}" CommandParameter="DualVertical"
                            ToolTip="2 Columns (Ctrl+Shift+2)"
                            Width="28" Height="26" Margin="1"
                            Content="◫" FontSize="12" />

                    <Button Command="{Binding SetLayoutCommand}" CommandParameter="DualHorizontal"
                            ToolTip="2 Rows (Ctrl+Shift+3)"
                            Width="28" Height="26" Margin="1"
                            Content="⬒" FontSize="12" />

                    <Button Command="{Binding SetLayoutCommand}" CommandParameter="TripleLeft"
                            ToolTip="Triple Layout (1 Left, 2 Right)"
                            Width="28" Height="26" Margin="1"
                            Content="◫+" FontSize="10" />

                    <Button Command="{Binding SetLayoutCommand}" CommandParameter="QuadGrid"
                            ToolTip="Quad Grid 2x2 (Ctrl+Shift+4)"
                            Width="28" Height="26" Margin="1"
                            Content="⊞" FontSize="13" />

                    <Separator Margin="6,4" Background="#E5E7EB" />

                    <!-- Actions -->
                    <Button Command="{Binding SplitVerticalCommand}"
                            ToolTip="Add Split Pane (Ctrl+Shift+T)"
                            Height="26" Padding="6,0" Margin="1"
                            Content="+ Split" FontSize="11" />

                    <Button Command="{Binding SwitchActivePaneCommand}"
                            ToolTip="Switch Active Pane (Tab)"
                            Height="26" Padding="6,0" Margin="2,1"
                            Content="⇄ Switch" FontSize="11" />

                    <Button Command="{Binding ToggleHiddenFilesCommand}"
                            ToolTip="Toggle Hidden Files (Ctrl+H)"
                            Height="26" Padding="6,0" Margin="1"
                            Content="👁 Hidden" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Sidebar + Multi-Pane Workspace) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="190" MinWidth="130" MaxWidth="320" />
                <!-- Splitter between Sidebar and File Panes -->
                <ColumnDefinition Width="4" />
                <!-- Multi-Pane Content -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,1,0"
                    Padding="6,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Favorites Group -->
                        <TextBlock Text="FAVORITES"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#9CA3AF"
                                   Margin="8,4,8,4" />

                        <ListBox ItemsSource="{Binding SidebarFavorites}"
                                 ItemTemplate="{StaticResource SidebarItemTemplate}"
                                 ItemContainerStyle="{StaticResource SidebarItemContainerStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="OnSidebarSelectionChanged" />

                        <!-- Divider -->
                        <Separator Margin="6,10" Background="#E5E7EB" />

                        <!-- Drives Group -->
                        <TextBlock Text="DRIVES"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#9CA3AF"
                                   Margin="8,4,8,4" />

                        <ListBox ItemsSource="{Binding SidebarDrives}"
                                 ItemTemplate="{StaticResource SidebarItemTemplate}"
                                 ItemContainerStyle="{StaticResource SidebarItemContainerStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="OnSidebarSelectionChanged" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Splitter for Sidebar -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E5E7EB"
                          ShowsPreview="False" />

            <!-- Dynamic Multi-Pane Workspace -->
            <views:MultiPaneWorkspace x:Name="WorkspaceControl"
                                      Grid.Column="2"
                                      Margin="4" />
        </Grid>

        <!-- Bottom Transfer Drawer -->
        <views:TransferDrawerView Grid.Row="2" DataContext="{Binding TransferDrawer}" />
    </Grid>
</Window>
